# Port the server listens on
PORT=3001

# Environment: development | production | test
NODE_ENV=development

# Secret used to sign JWTs — must be at least 32 random characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=humora-change-this-in-production-min-32-chars

# Lifetime of short-lived widget challenge tokens
JWT_EXPIRES_IN=5m

# Lifetime of long-lived authenticated session tokens
AUTH_JWT_EXPIRES_IN=7d

# ─── Dodo Payments ────────────────────────────────────────────────────────────
# Sign up and manage keys at https://dashboard.dodopayments.com

# Secret API key — use sk_test_* in development, sk_live_* in production
DODO_SECRET_KEY=sk_test_your_dodo_secret_key

# Webhook signing secret — found in the Dodo dashboard under Developers → Webhooks
# Create an endpoint pointing to https://yourdomain.com/api/billing/webhook
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret_here

# Product IDs — create one product per plan/period in the Dodo dashboard under Products
# Each product ID starts with "pdt_"
DODO_PRODUCT_STARTER_MONTHLY=pdt_xxxxxxxxxxxxxxxx
DODO_PRODUCT_STARTER_ANNUAL=pdt_xxxxxxxxxxxxxxxx
DODO_PRODUCT_PRO_MONTHLY=pdt_xxxxxxxxxxxxxxxx
DODO_PRODUCT_PRO_ANNUAL=pdt_xxxxxxxxxxxxxxxx

# ─── URLs ─────────────────────────────────────────────────────────────────────

# Comma-separated list of origins the CORS middleware will allow
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public URL of the frontend — used in redirect links after checkout and cancellation
FRONTEND_URL=http://localhost:3000

# Public URL of this backend deployment
SERVER_URL=http://localhost:3001

# Supabase project URL used to verify OAuth access tokens
SUPABASE_URL=https://your-project-ref.supabase.co

# ─── Admin ────────────────────────────────────────────────────────────────────

# Email address granted admin-level access to the API
ADMIN_EMAIL=admin@humora.io
