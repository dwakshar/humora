{
  "name": "@humora-io/widget",
  "version": "1.0.1",
  "description": "Human verification widget — the CAPTCHA replacement developers actually enjoy building with.",
  "author": "Humora",
  "license": "MIT",
  "type": "module",
  "main": "dist/lib/index.cjs",
  "module": "dist/lib/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/lib/index.mjs",
      "require": "./dist/lib/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.js",
    "build:iife": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
