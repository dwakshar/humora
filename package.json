{
  "name": "humora",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:widget": "npm run dev --workspace=apps/widget",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev": "concurrently \"npm run dev:widget\" \"npm run dev:web\" \"npm run dev:server\"",
    "build:widget": "npm run build --workspace=apps/widget",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:widget && npm run build:web",
    "lint": "eslint apps/*/src --ext .js,.jsx"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react-router-dom": "^7.14.2"
  }
}
